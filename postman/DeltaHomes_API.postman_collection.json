{
  "info": {
    "_postman_id": "7f4c2d0e-9b3a-4f6e-8d1c-3a5b7e9f2a41",
    "name": "Delta Homes API",
    "description": "Backend REST API for the Delta Homes marketplace (Spring Boot + PostgreSQL).\n\nBase URL is controlled by the collection variable `baseUrl` (default http://localhost:8080).\n\nThe `token` and `refreshToken` collection variables are set automatically after a successful **Login** or **Login with OTP** request, so authenticated requests can use `Authorization: Bearer {{token}}`.\n\nTo register a new account:\n1. POST /auth/otp/send with purpose REGISTRATION\n2. Read the OTP from the server console (dev mode) or the SMS.\n3. POST /auth/register with the code in `otpCode`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01012345678\",\n  \"purpose\": \"REGISTRATION\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "otp",
                "send"
              ]
            },
            "description": "Sends a 6-digit SMS OTP. `purpose` is one of REGISTRATION | LOGIN | PASSWORD_RESET.\nIn dev mode (no Twilio credentials) the code is printed to the server console."
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01012345678\",\n  \"code\": \"123456\",\n  \"purpose\": \"REGISTRATION\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "otp",
                "verify"
              ]
            },
            "description": "Verifies an OTP code without creating any account. Optional — the register/login endpoints verify the code themselves."
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmed Hassan\",\n  \"phone\": \"01012345678\",\n  \"password\": \"secret123\",\n  \"role\": \"CUSTOMER\",\n  \"otpCode\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Registers a new account. Requires a verified REGISTRATION OTP. `role` is one of CUSTOMER | OWNER | OFFICE | COMPANY | TECHNICIAN (ADMIN is provisioned by the platform). Returns access + refresh tokens."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01012345678\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Logs in with phone + password. Stores the returned tokens in the `token` and `refreshToken` collection variables for subsequent requests.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "const json = pm.response.json();",
                    "if (json.accessToken) {",
                    "  pm.collectionVariables.set('token', json.accessToken);",
                    "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                    "}",
                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                    "pm.test('Has access token', () => pm.expect(json.accessToken).to.be.a('string'));"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Login with OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01012345678\",\n  \"otpCode\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login/otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login",
                "otp"
              ]
            },
            "description": "Password-less login using a LOGIN-purpose OTP. The account must already exist. Also stores tokens into collection variables."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Exchanges a valid refresh token for a fresh pair of access + refresh tokens."
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Returns the profile of the currently authenticated user (requires a valid access token)."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"secret123\",\n  \"newPassword\": \"newsecret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "password"
              ]
            },
            "description": "Changes the password of the authenticated user. Requires the current password."
          }
        },
        {
          "name": "Reset Password (via OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01012345678\",\n  \"otpCode\": \"123456\",\n  \"newPassword\": \"brandnew123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/password/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "password",
                "reset"
              ]
            },
            "description": "Resets a forgotten password. Requires a PASSWORD_RESET OTP sent to the account phone. No authentication needed."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Logs out. The API is stateless, so the client simply discards its tokens."
          }
        }
      ]
    },
