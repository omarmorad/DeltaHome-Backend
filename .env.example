# Copy to .env and fill in. Never commit real values.
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/deltahome
DB_USERNAME=postgres
DB_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@example.com
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=change-me
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+10000000000
FIREBASE_CONFIG_PATH=classpath:firebase-service-account.json
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET=deltahomes-media
STORAGE_REGION=auto
JWT_SECRET=use-a-long-random-base64-string
APP_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
ADMIN_PHONE=+10000000001
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Leave empty to disable the fixed-OTP bootstrap login.
ADMIN_PERMANENT_OTP=
SEED_ENABLED=true
SEED_TARGET=5
